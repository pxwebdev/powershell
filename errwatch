$folder = 'C:\LFaxOut'
$filter = '*.err'
$log    = 'C:\pstools\systool\fsw.log'

$fsw = [System.IO.FileSystemWatcher]::new($folder, $filter)
$fsw.IncludeSubdirectories = $false
$fsw.NotifyFilter = [IO.NotifyFilters]'FileName, LastWrite'
$fsw.EnableRaisingEvents = $true

$null = Register-ObjectEvent $fsw Created -SourceIdentifier LFaxErrCreated -Action {
    $name = $Event.SourceEventArgs.Name
    $path = $Event.SourceEventArgs.FullPath
    $ts   = $Event.TimeGenerated

    Add-Content -Path 'C:\pstools\systool\fsw.log' -Value "$ts  $name created"

    Start-Sleep -Seconds 1   # let the writer finish
    & 'C:\pstools\systool\uptime.ps1' -Path $path
}

try {
    while ($true) { Start-Sleep -Seconds 5 }   # keep-alive
}
finally {
    Unregister-Event -SourceIdentifier LFaxErrCreated -ErrorAction SilentlyContinue
    $fsw.Dispose()
}